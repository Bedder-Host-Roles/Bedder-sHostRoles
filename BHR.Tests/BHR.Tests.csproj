<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
		<PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" PrivateAssets="all" />
		
		<PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
	</ItemGroup>

  <Target Name="CopyAssemblyCSharpForTests" AfterTargets="Build">
    <ItemGroup>
      <GameInteropAssemblies Include="$(NuGetPackageRoot)amongus.gamelibs.steam/2026.9.29/build/*.dll" />
      <GameInteropAssemblies Remove="$(NuGetPackageRoot)amongus.gamelibs.steam/2026.9.29/build/Newtonsoft.Json.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(GameInteropAssemblies)" DestinationFolder="$(OutDir)" />
  </Target>

  <ItemGroup>
	  <Folder Include="..\nuget.local\" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BHR.csproj" />
  </ItemGroup>

</Project>
